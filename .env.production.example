# PRODUCTION settings for the server only (EC2 / your host's secret store). Do NOT append this to the local .env:
# when a key appears twice the last one wins, which silently points local development at production (wrong CORS origins, live database).
# Keep secrets out of version control. Fill in the values on the server.
APP_ENV=production
FRONTEND_URL=https://app.shopscale.com.ng
STOREFRONT_URL=https://shopscale.com.ng/s
PUBLIC_API_URL=https://api.shopscale.com.ng
# The application, the marketing site / storefronts and www. No wildcard (credentials are used).
CORS_ALLOWED_ORIGINS=https://app.shopscale.com.ng,https://shopscale.com.ng,https://www.shopscale.com.ng
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict
COOKIE_DOMAIN=
# DB_URL, DB_USERNAME, DB_PASSWORD, JWT_SECRET, PAYSTACK_*, RESEND_* ... set on the server.

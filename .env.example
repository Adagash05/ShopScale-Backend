# Copy to .env (or export in your shell). Never commit real values.
# production (the default when unset) REFUSES TO START with missing or localhost payment settings. Use development locally.
APP_ENV=development
# PAYSTACK_SECRET_KEY, APP_ENCRYPTION_KEY and PUBLIC_API_URL are below; production needs all three.
# Production: APP_ENV=production, FRONTEND_URL=https://app.shopscale.com.ng, PUBLIC_API_URL=https://api.shopscale.com.ng
DB_URL=jdbc:postgresql://localhost:5432/shopscale
DB_USERNAME=shopscale
DB_PASSWORD=change-me
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Production: https://app.shopscale.com.ng,https://shopscale.com.ng,https://www.shopscale.com.ng
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Refresh cookie. Production: COOKIE_SECURE=true, COOKIE_SAMESITE=Strict, COOKIE_DOMAIN empty. Local http dev: COOKIE_SECURE=false.
COOKIE_SECURE=false
COOKIE_SAMESITE=Strict
COOKIE_DOMAIN=
PORT=8080

# Link base used in staff invitation emails (your deployed frontend URL)
FRONTEND_URL=http://localhost:5173
# Email is OPTIONAL. Without it, invitations still work: the inviter is shown the link to send themselves.
# To enable email set all of these (standard Spring Boot mail settings):
# Resend over SMTP (verify the shopscale.com.ng domain in Resend first). Set ALL of these or none.
# MAIL_FROM=ShopScale <no-reply@shopscale.com.ng>
# SPRING_MAIL_HOST=smtp.resend.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=resend
# SPRING_MAIL_PASSWORD=<your Resend API key, e.g. re_...>
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- Online store (merchants' own Paystack keys are stored encrypted with this key) ---
# 32 random bytes, base64. Generate with: openssl rand -base64 32   (losing it means merchants must re-enter their Paystack keys)
APP_ENCRYPTION_KEY=
# Public URL of THIS API, used in the webhook URL shown to merchants and in product image links, e.g. https://api.shopscale.fidmap.co
PUBLIC_API_URL=http://localhost:8080
# Optional. Base URL of storefront pages. Default: FRONTEND_URL + /s
STOREFRONT_URL=

# --- ShopScale subscriptions: the AMSATI Paystack account (never the merchants') ---
PAYSTACK_SECRET_KEY=

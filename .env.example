# Copy to .env (or export in your shell). Never commit real values.
DB_URL=jdbc:postgresql://localhost:5432/shopscale
DB_USERNAME=shopscale
DB_PASSWORD=change-me
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080

# Link base used in staff invitation emails (your deployed frontend URL)
FRONTEND_URL=http://localhost:5173
# Email is OPTIONAL. Without it, invitations still work: the inviter is shown the link to send themselves.
# To enable email set all of these (standard Spring Boot mail settings):
# MAIL_FROM=ShopScale <no-reply@yourdomain.com>
# SPRING_MAIL_HOST=smtp.yourprovider.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=...
# SPRING_MAIL_PASSWORD=...
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
